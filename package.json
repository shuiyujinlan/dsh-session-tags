{
  "name": "dsh-session-tags",
  "version": "0.2.0",
  "type": "module",
  "description": "Tag sessions across workspaces and browse them as a colored, collapsible tag tree in the left sidebar. 给任意工作区的会话打标签，在左侧栏按彩色标签树折叠分组浏览。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "tags",
    "grouping",
    "sidebar"
  ],
  "license": "MIT",
  "author": "dsh-session-tags contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-session-tags.git"
  },
  "homepage": "https://github.com/OWNER/dsh-session-tags",
  "bugs": {
    "url": "https://github.com/OWNER/dsh-session-tags/issues"
  },
  "engines": {
    "node": ">=22.13"
  }
}
